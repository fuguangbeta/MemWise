auto_start_admin: true
auto_start_daemon: true
auto_start_minimize: true
clean_mode: full
clean_operations:
- ws
- standby
- modified
- volume
- registry
clean_passes: 4
close_action: minimize
efis_params:
  anchor_margin: 0.15
  composite_kalman_w: 0.1
  cooloff_base: 360
  cpu_gate: 8.0
  deepen_theta: 0.6
  io_gate: 4.0
  kalman_r: 2.9999999999999996
  layer3_agg_gate: 0.6
  learning_rate: 0.1
  pid_kd: 0.09999999999999999
  pid_kp: 0.45
  target_usage: 35
emergency_abs_pct: 0
emergency_threshold: 90
game_hotkey: ctrl+shift+g
game_processes:
- worldbox.exe
- cities.exe
- eotu-win64-shipping.exe
- craftworld.exe
gap_seconds: 12
hotkey: ctrl+shift+m
interval: 60
kd: 0.1
ki: 0.15
kp: 1.0
language: zh_CN
log_to_file: true
never: []
target_usage: 45
tray_left_action: show
